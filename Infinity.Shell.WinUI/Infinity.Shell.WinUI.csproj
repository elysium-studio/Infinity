<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows10.0.22000.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Infinity.Shell.WinUI</RootNamespace>
		<AssemblyName>Infinity</AssemblyName>
		<AssemblyTitle>Infinity</AssemblyTitle>
		<ApplicationIcon>Assets\Infinity.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64</Platforms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>false</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<Nullable>enable</Nullable>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<StartupObject>Infinity.Shell.WinUI.Start</StartupObject>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<PublishAot>true</PublishAot>
		<IsAotCompatible>true</IsAotCompatible>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<InvariantGlobalization>true</InvariantGlobalization>
		<DefaultLanguage>en</DefaultLanguage>
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootDescriptor Include="TrimmerRootDescriptor.xml" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Assets\**\*">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<PRIResource Include="Strings\**\*.resw" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.3.260402-preview2" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
		<PackageReference Include="CommunityToolkit.WinUI.Triggers" Version="8.3.260402-preview2" />
		<PackageReference Include="Elysium.Application" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Application.Abstractions" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Application.DependencyInjection" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Licensing" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Licensing.Abstractions" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Licensing.DependencyInjection" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Platform.Abstractions" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Platform.Windows" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Presentation" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Presentation.Abstractions" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Presentation.DependencyInjection" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.UI.WinUI" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Updates" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Updates.Abstractions" Version="$(ElysiumVersion)" />
		<PackageReference Include="Elysium.Updates.DependencyInjection" Version="$(ElysiumVersion)" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" GeneratePathProperty="true" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
		<PackageReference Include="Velopack" Version="1.2.0" />
		<PackageReference Include="WinUIEx" Version="2.9.2" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Infinity.Application.DependencyInjection\Infinity.Application.DependencyInjection.csproj" />
		<ProjectReference Include="..\Infinity.Platform.DependencyInjection.Windows\Infinity.Platform.Windows.DependencyInjection.csproj" />
		<ProjectReference Include="..\Infinity.Platform.Windows\Infinity.Platform.Windows.csproj" />
		<ProjectReference Include="..\Infinity.Shell\Infinity.Shell.csproj" />
		<ProjectReference Include="..\Infinity.UI.WinUI\Infinity.UI.WinUI.csproj" />
		<Content Include="..\Infinity.Platform.Windows.Native\$(Platform)\$(Configuration)\Infinity.Platform.Windows.Native.dll">
			<Link>Infinity.Platform.Windows.Native.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
	<Target Name="CopyPriAndXbfToPublish" AfterTargets="Publish">
		<ItemGroup>
			<PriFiles Include="$(OutDir)*.pri" />
			<XbfFiles Include="$(OutDir)*.xbf" />
		</ItemGroup>
		<Copy SourceFiles="@(PriFiles)" DestinationFolder="$(PublishDir)" />
		<Copy SourceFiles="@(XbfFiles)" DestinationFolder="$(PublishDir)" />
	</Target>
	<UsingTask TaskName="ExtractWindowsAppRuntimeInsightsResource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<ArchivePath ParameterType="System.String" Required="true" />
			<OutputPath ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.IO.Compression" />
			<Code Type="Fragment" Language="cs"><![CDATA[
                const string entryName = "Microsoft.WindowsAppRuntime.Insights.Resource.dll";
                using (ZipArchive archive = ZipFile.OpenRead(ArchivePath))
                {
                    ZipArchiveEntry entry = archive.GetEntry(entryName);
                    if (entry == null)
                    {
                        Log.LogError($"{entryName} was not found in {ArchivePath}.");
                    }
                    else
                    {
                        Directory.CreateDirectory(Path.GetDirectoryName(OutputPath) ?? ".");
                        entry.ExtractToFile(OutputPath, true);
                    }
                }
            ]]></Code>
		</Task>
	</UsingTask>
	<Target Name="CopyWindowsAppRuntimeInsightsResourceToPublish" AfterTargets="Publish" Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
		<PropertyGroup>
			<WindowsAppRuntimeFrameworkMsix>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix</WindowsAppRuntimeFrameworkMsix>
		</PropertyGroup>
		<Error Condition="!Exists('$(WindowsAppRuntimeFrameworkMsix)')" Text="Windows App Runtime framework package was not found at $(WindowsAppRuntimeFrameworkMsix)." />
		<ExtractWindowsAppRuntimeInsightsResource ArchivePath="$(WindowsAppRuntimeFrameworkMsix)" OutputPath="$(PublishDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
	</Target>
</Project>
