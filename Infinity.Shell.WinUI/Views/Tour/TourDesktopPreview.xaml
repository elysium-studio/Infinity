<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.TourDesktopPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Tour/TourVisualResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid
        x:Name="Scene"
        Width="520"
        Height="200">
        <Border CornerRadius="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FF07152A" />
                    <GradientStop Offset="0.58" Color="#FF173A70" />
                    <GradientStop Offset="1" Color="#FF0A1830" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Ellipse
            Width="310"
            Height="200"
            Margin="-110,-80,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#A34CC2FF" />
                    <GradientStop Offset="1" Color="#004CC2FF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse
            Width="260"
            Height="180"
            Margin="0,0,-100,-90"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0.16">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#8B9A72FF" />
                    <GradientStop Offset="1" Color="#009A72FF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Border Background="#76020914" CornerRadius="12" />
        <Grid x:Name="OverviewChrome">
            <Border
                Width="132"
                Height="18"
                Margin="0,9,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#D10B1B31"
                BorderBrush="#32FFFFFF"
                BorderThickness="1"
                CornerRadius="9">
                <StackPanel Margin="9,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="7" Foreground="#AFFFFFFF" Glyph="&#xE721;" />
                    <Border Width="75" Height="2" Background="#4FFFFFFF" CornerRadius="1" />
                </StackPanel>
            </Border>
            <FontIcon
                Margin="0,12,13,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontSize="10"
                Foreground="#BFFFFFFF"
                Glyph="&#xE713;" />
        </Grid>
        <Grid x:Name="PageWorld">
            <Canvas>
                <Grid Canvas.Left="-52" Canvas.Top="42" Width="200" Height="143">
                    <Border Width="82" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#E010223D" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="SemiBold" Text="Previous" />
                    </Border>
                    <Border Margin="0,28,0,0" Background="#EA061023" BorderBrush="#3FFFFFFF" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Border Width="96" Height="65" Margin="18,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D5172639" BorderBrush="#52FFFFFF" BorderThickness="1" CornerRadius="3" />
                            <Border Width="66" Height="46" Margin="0,45,16,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D5253448" BorderBrush="#42FFFFFF" BorderThickness="1" CornerRadius="3" />
                        </Grid>
                    </Border>
                    <Border x:Name="PageThreeAccent" Margin="0,28,0,0" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="7" Opacity="0" />
                </Grid>
                <Grid Canvas.Left="160" Canvas.Top="42" Width="200" Height="143">
                    <Border Width="82" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#E010223D" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="SemiBold" Text="Page 1" />
                    </Border>
                    <Border Margin="0,28,0,0" Background="#EA061023" BorderBrush="#3FFFFFFF" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Border Width="62" Height="39" Margin="11,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CD244B7F" CornerRadius="3" />
                            <Border Width="71" Height="43" Margin="0,58,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#CD1A2E47" BorderBrush="#3FFFFFFF" BorderThickness="1" CornerRadius="3" />
                        </Grid>
                    </Border>
                    <Border x:Name="PageOneAccent" Margin="0,28,0,0" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="7" />
                </Grid>
                <Grid Canvas.Left="372" Canvas.Top="42" Width="200" Height="143">
                    <Border Width="82" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#E010223D" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5">
                        <TextBlock x:Name="RightPageTitle" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="SemiBold" Text="Page 2" />
                    </Border>
                    <Border Margin="0,28,0,0" Background="#EA061023" BorderBrush="#3FFFFFFF" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Border Width="118" Height="66" Margin="10,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D51B2C43" BorderBrush="#52FFFFFF" BorderThickness="1" CornerRadius="3" />
                            <Border Width="52" Height="75" Margin="0,26,9,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D5263B59" BorderBrush="#42FFFFFF" BorderThickness="1" CornerRadius="3" />
                        </Grid>
                    </Border>
                    <Border x:Name="PageTwoAccent" Margin="0,28,0,0" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="7" Opacity="0" />
                </Grid>
                <Border
                    x:Name="MovingWindow"
                    Width="116"
                    Height="62"
                    Canvas.Left="198"
                    Canvas.Top="96"
                    Background="#F116263B"
                    BorderBrush="#AFFFFFFF"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Border Height="9" VerticalAlignment="Top" Background="#754A8AD4" CornerRadius="4,4,0,0" />
                        <StackPanel Margin="10,20,10,7" Spacing="5">
                            <Border Width="66" Height="3" HorizontalAlignment="Left" Background="#9AFFFFFF" CornerRadius="2" />
                            <Border Width="87" Height="3" HorizontalAlignment="Left" Background="#43FFFFFF" CornerRadius="2" />
                            <Border Width="52" Height="3" HorizontalAlignment="Left" Background="#43FFFFFF" CornerRadius="2" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    x:Name="DestinationGlow"
                    Width="126"
                    Height="72"
                    Canvas.Left="386"
                    Canvas.Top="91"
                    Background="#1F4CC2FF"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    Opacity="0" />
                <Path
                    x:Name="PointerGlyph"
                    Width="16"
                    Height="20"
                    Canvas.Left="292"
                    Canvas.Top="144"
                    Data="M 1,1 L 1,17 L 5.5,13 L 9,19 L 12,17.5 L 8.5,11.5 L 15,11 Z"
                    Fill="White"
                    Stroke="#B0000000"
                    StrokeThickness="1"
                    Visibility="Collapsed" />
            </Canvas>
        </Grid>
        <Border BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" />
    </Grid>
</UserControl>
