<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.WindowDragTriggerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Local="using:Infinity.Shell.WinUI"
    xmlns:WinUI="using:Elysium.UI.WinUI"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Center"
    VerticalContentAlignment="Top"
    DataContext="{WinUI:ViewModel Key=WindowDragTriggerView}"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Tour/TourVisualResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Width="600" MinHeight="416" HorizontalAlignment="Center" RowDefinitions="304,22,Auto">
        <Border Style="{StaticResource TourHeroCardStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Local:TourKeyChord
                    HorizontalAlignment="Center"
                    ActionLabel="DRAG"
                    FirstModifier="{x:Bind ViewModel.FirstModifier, Mode=OneWay}"
                    SecondModifier="{x:Bind ViewModel.SecondModifier, Mode=OneWay}" />
                <Local:TourDesktopPreview Scenario="DragWindow" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Spacing="8">
            <TextBlock x:Uid="TourWindowDragTitle" Style="{StaticResource TourLessonTitleStyle}" />
            <TextBlock Style="{StaticResource TourLessonBodyStyle}">
                <Run x:Uid="TourWindowDragInstructionPrefix" />
                <Run Text="{x:Bind ViewModel.FirstModifier, Mode=OneWay}" />
                <Run Text="+" />
                <Run Text="{x:Bind ViewModel.SecondModifier, Mode=OneWay}" />
                <Run x:Uid="TourWindowDragInstructionSuffix" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
