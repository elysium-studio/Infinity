<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.DragScrollSpeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}">
    <CommunityToolkit:SettingsCard x:Uid="DragScrollSpeedCard">
        <ComboBox SelectedIndex="{x:Bind ViewModel.Value, Mode=TwoWay}">
            <ComboBoxItem x:Uid="SpeedSlowOption" />
            <ComboBoxItem x:Uid="SpeedNormalOption" />
            <ComboBoxItem x:Uid="SpeedFastOption" />
            <ComboBoxItem x:Uid="SpeedTurboOption" />
        </ComboBox>
    </CommunityToolkit:SettingsCard>
</UserControl>
