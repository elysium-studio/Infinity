<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.TrackedWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <ThemeShadow x:Name="SharedShadow" />
    </UserControl.Resources>
    <Canvas>
        <ItemContainer
            x:Name="WindowContainer"
            Canvas.Left="{x:Bind ViewModel.X, Mode=OneWay}"
            Canvas.Top="{x:Bind ViewModel.Y, Mode=OneWay}"
            Width="{x:Bind ViewModel.Width, Mode=OneWay}"
            Height="{x:Bind ViewModel.Height, Mode=OneWay}"
            Background="Transparent"
            FocusVisualPrimaryThickness="0"
            FocusVisualSecondaryThickness="0"
            IsTabStop="False"
            PointerEntered="HandleWindowContainerPointerEntered"
            PointerExited="HandleWindowContainerPointerExited"
            Tapped="{x:Bind ViewModel.Navigate}"
            ToolTipService.ToolTip="{x:Bind ViewModel.Title}">
            <ItemContainer.Resources>
                <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
            </ItemContainer.Resources>
            <Grid x:Name="ThumbnailGrid">
                <Border
                    x:Name="ThumbnailShadowHost"
                    Margin="6"
                    Background="Transparent"
                    Shadow="{StaticResource SharedShadow}"
                    Translation="0,0,32">
                    <Border
                        x:Name="ThumbnailHost"
                        Background="Transparent"
                        IsHitTestVisible="False" />
                </Border>
                <Border
                    x:Name="SelectionBorder"
                    BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ToSelectionVisibility(ViewModel.IsSelected), Mode=OneWay}" />
                <Button
                    x:Name="CloseButton"
                    x:Uid="CloseWindowButton"
                    Width="24"
                    Height="24"
                    Margin="0,8,8,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="{x:Bind ViewModel.Close}"
                    CornerRadius="4"
                    IsTabStop="False"
                    PointerEntered="HandleCloseButtonPointerEntered"
                    PointerExited="HandleCloseButtonPointerExited">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#26000000" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Opacity="0.9"
                                        Color="#C42B1C" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#26000000" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Opacity="0.9"
                                        Color="#C42B1C" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorWindowColor}" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="10"
                        Glyph="&#xE8BB;" />
                </Button>
            </Grid>
        </ItemContainer>
    </Canvas>
</UserControl>
