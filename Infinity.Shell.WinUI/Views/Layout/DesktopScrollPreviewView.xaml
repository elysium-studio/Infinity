<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.DesktopScrollPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    Opacity="0">
    <Grid x:Name="PreviewSurface">
        <Grid
            x:Name="DismissSurface"
            Background="Transparent"
            Tapped="HandleDismissSurfaceTapped" />
        <Canvas>
            <Canvas x:Name="PageCanvas" />
        </Canvas>
        <Canvas x:Name="PreviewCanvas" />
    </Grid>
</UserControl>
