<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.PreviewSizeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="PreviewSizeCard">
        <ComboBox SelectedIndex="{x:Bind ViewModel.Value, Mode=TwoWay}">
            <ComboBoxItem x:Uid="PreviewSizeCompactOption" />
            <ComboBoxItem x:Uid="PreviewSizeDefaultOption" />
            <ComboBoxItem x:Uid="PreviewSizeLargeOption" />
        </ComboBox>
    </CommunityToolkit:SettingsCard>
</UserControl>
