<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.DesktopPageTitleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="276"
    Height="80">
    <Grid>
        <Border
            x:Name="HeaderSurface"
            Width="240"
            Margin="18"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid>
                <TextBlock
                    Margin="-24,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ToDisplayVisibility(ViewModel.IsEditing), Mode=OneWay}" />
                <TextBox
                    x:Name="TitleTextBox"
                    Margin="8,0,52,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    KeyDown="HandleEditorKeyDown"
                    MaxLength="80"
                    Text="{x:Bind ViewModel.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ToEditVisibility(ViewModel.IsEditing), Mode=OneWay}" />
                <StackPanel
                    Margin="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Rectangle
                        Width="1"
                        Margin="4"
                        VerticalAlignment="Stretch"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        AutomationProperties.Name="{x:Bind ViewModel.EditLabel}"
                        Click="{x:Bind ViewModel.BeginEditing}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.EditLabel}"
                        Visibility="{x:Bind ToDisplayVisibility(ViewModel.IsEditing), Mode=OneWay}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        </Button.Resources>
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        AutomationProperties.Name="{x:Bind ViewModel.SaveLabel}"
                        Click="{x:Bind ViewModel.Submit}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SaveLabel}"
                        Visibility="{x:Bind ToEditVisibility(ViewModel.IsEditing), Mode=OneWay}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        </Button.Resources>
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
