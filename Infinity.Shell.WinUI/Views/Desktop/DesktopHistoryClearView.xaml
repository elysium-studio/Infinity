<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.DesktopHistoryClearView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="DesktopHistoryClearCard">
        <Button
            x:Uid="DesktopHistoryClearButton"
            Click="{x:Bind ViewModel.Clear}"
            IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" />
    </CommunityToolkit:SettingsCard>
</UserControl>
