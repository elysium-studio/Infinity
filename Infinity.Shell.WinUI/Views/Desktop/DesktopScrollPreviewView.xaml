<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.DesktopScrollPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Infinity.Shell.WinUI"
    xmlns:shell="using:Infinity.Shell"
    Background="Transparent"
    Opacity="0">
    <UserControl.Resources>
        <Flyout x:Name="ApplicationPickerFlyout" Placement="Bottom">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <Grid Width="420" Height="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Padding="24,16"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Grid>
                        <TextBox
                            x:Name="ApplicationSearchBox"
                            x:Uid="DesktopAppPickerSearchBox"
                            Height="40"
                            Padding="38,0,12,0"
                            CornerRadius="20"
                            Text="{x:Bind ApplicationPicker.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Resources>
                                <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillColorDefaultBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillColorInputActiveBrush" />
                                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlElevationBorderBrush" />
                                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlElevationBorderBrush" />
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlElevationBorderBrush" />
                            </TextBox.Resources>
                        </TextBox>
                        <FontIcon
                            Margin="14,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE721;"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid
                    Grid.Row="2"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <ListView
                        x:Name="ApplicationResultsList"
                        Margin="28,12,20,12"
                        Background="Transparent"
                        ContainerContentChanging="HandleApplicationContainerContentChanging"
                        IsItemClickEnabled="True"
                        ItemClick="HandleApplicationClicked"
                        ItemsSource="{x:Bind ApplicationPicker.Results}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="shell:DesktopApplicationPickerItemViewModel">
                                <Grid
                                    MinHeight="40"
                                    Padding="8,2"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind local:DesktopScrollPreviewView.ToStaticVisibility(ShowFallbackIcon), Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE71D;" />
                                    </Border>
                                    <Image
                                        Width="24"
                                        Height="24"
                                        Source="{x:Bind local:DesktopScrollPreviewView.CreateApplicationIconSource(Icon), Mode=OneWay}"
                                        Stretch="Uniform"
                                        UseLayoutRounding="True"
                                        Visibility="{x:Bind local:DesktopScrollPreviewView.ToApplicationIconVisibility(Icon), Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ProgressRing
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ApplicationPicker.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ToVisibility(ApplicationPicker.IsLoading), Mode=OneWay}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ToVisibility(ApplicationPicker.ShowEmptyState), Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="24"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE721;" />
                        <TextBlock x:Uid="DesktopAppPickerEmpty" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Flyout>
    </UserControl.Resources>
    <Grid>
        <Canvas x:Name="PageShadowCanvas" IsHitTestVisible="False" />
        <Grid x:Name="PreviewSurface">
            <Grid
                x:Name="DismissSurface"
                Background="Transparent"
                Tapped="HandleDismissSurfaceTapped" />
            <Canvas>
                <Canvas x:Name="PageCanvas" />
            </Canvas>
            <Canvas x:Name="PreviewCanvas" />
            <Canvas x:Name="FocusCanvas" IsHitTestVisible="False" />
        </Grid>
        <Canvas x:Name="PageTitleCanvas" />
        <Button
            x:Name="ShortcutHintSurface"
            x:Uid="DesktopShortcutHintsButton"
            Height="36"
            Padding="16,0,12,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsTabStop="False">
            <Button.Resources>
                <StaticResource x:Key="ButtonBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlElevationBorderBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlElevationBorderBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlElevationBorderBrush" />
            </Button.Resources>
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="F1" Invoked="HandleShortcutHintsInvoked" />
            </Button.KeyboardAccelerators>
            <Button.Flyout>
                <Flyout x:Name="ShortcutHintsFlyout" Placement="Top">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="MaxWidth" Value="520" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Grid Width="472">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="24,20,24,16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="DesktopShortcutHintsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="DesktopShortcutHintsDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Padding="24,12" Spacing="8">
                                <TextBlock
                                    x:Uid="DesktopShortcutNavigationGroup"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    CharacterSpacing="80" />
                                <Grid MinHeight="40" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="DesktopShortcutSwitchPage" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <local:DesktopShortcutChord
                                        Grid.Column="1"
                                        ActionLabel="←  →"
                                        FirstModifier="{x:Bind ShortcutHints.FirstModifier, Mode=OneWay}"
                                        SecondModifier="{x:Bind ShortcutHints.SecondModifier, Mode=OneWay}" />
                                </Grid>
                                <Grid MinHeight="40" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="DesktopShortcutGoToPage" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <local:DesktopShortcutChord
                                        Grid.Column="1"
                                        ActionLabel="1–0"
                                        FirstModifier="{x:Bind ShortcutHints.FirstModifier, Mode=OneWay}"
                                        SecondModifier="{x:Bind ShortcutHints.SecondModifier, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Padding="24,12,24,16" Spacing="8">
                                <TextBlock
                                    x:Uid="DesktopShortcutWindowGroup"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    CharacterSpacing="80" />
                                <Grid MinHeight="40" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="DesktopShortcutMoveWindow" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <local:DesktopShortcutChord
                                        Grid.Column="1"
                                        ActionLabel="←  →"
                                        FirstModifier="{x:Bind ShortcutHints.FirstModifier, Mode=OneWay}"
                                        SecondModifier="{x:Bind ShortcutHints.SecondModifier, Mode=OneWay}"
                                        ShowShift="True" />
                                </Grid>
                                <Grid MinHeight="40" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="DesktopShortcutSendWindow" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <local:DesktopShortcutChord
                                        Grid.Column="1"
                                        ActionLabel="1–0"
                                        FirstModifier="{x:Bind ShortcutHints.FirstModifier, Mode=OneWay}"
                                        SecondModifier="{x:Bind ShortcutHints.SecondModifier, Mode=OneWay}"
                                        ShowShift="True" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Flyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE765;" />
                <TextBlock x:Uid="DesktopShortcutHintsButtonLabel" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Border
                    MinWidth="28"
                    Height="24"
                    Padding="8,0"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="F1" />
                </Border>
            </StackPanel>
        </Button>
        <Grid
            Width="664"
            Height="44"
            Margin="0,32,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="2">
                <TextBox
                    x:Name="WindowSearchBox"
                    x:Uid="WindowSearchBox"
                    Padding="48,10,40,4"
                    CornerRadius="22"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    KeyDown="HandleWindowSearchBoxKeyDown"
                    KeyUp="HandleWindowSearchBoxKeyUp"
                    TextChanged="HandleWindowSearchBoxTextChanged"
                    VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillColorDefaultBrush" />
                        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillColorInputActiveBrush" />
                        <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlElevationBorderBrush" />
                        <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlElevationBorderBrush" />
                        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlElevationBorderBrush" />
                    </TextBox.Resources>
                </TextBox>
                <FontIcon
                    Margin="17,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Glyph="&#xE721;"
                    IsHitTestVisible="False" />
            </Grid>
            <Button
                x:Name="SettingsButton"
                x:Uid="WindowSettingsButton"
                Grid.Column="4"
                Width="40"
                Height="40"
                Padding="0"
                VerticalAlignment="Center"
                Click="HandleSettingsButtonClicked"
                IsHitTestVisible="False"
                IsTabStop="False">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                </Button.Resources>
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
