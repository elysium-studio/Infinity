<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.DesktopHistoryCapacityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard
        x:Uid="DesktopHistoryCapacityCard"
        IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
        <NumberBox
            LargeChange="25"
            Maximum="500"
            Minimum="10"
            SmallChange="5"
            SpinButtonPlacementMode="Hidden"
            Value="{x:Bind ViewModel.Value, Mode=TwoWay}" />
    </CommunityToolkit:SettingsCard>
</UserControl>
