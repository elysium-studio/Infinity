<UserControl
    x:Class="Infinity.Shell.WinUI.DesktopWindowPeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <Grid Background="Transparent" Tapped="HandleBackgroundTapped" PointerWheelChanged="HandlePointerWheelChanged">
        <Border x:Name="Dimmer" Background="{ThemeResource SmokeFillColorDefaultBrush}" />
        <Border
            x:Name="PreviewFrame"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="12"
            PointerPressed="HandlePreviewPointerPressed"
            Tapped="HandlePreviewTapped">
            <Viewbox x:Name="PeekContent" Stretch="Uniform" />
        </Border>
    </Grid>
</UserControl>
