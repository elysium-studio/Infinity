<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.DesktopHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Shell="using:Infinity.Shell"
    xmlns:WinUI="using:Elysium.UI.WinUI"
    DataContext="{WinUI:ViewModel Key=DesktopHistoryView}"
    IsTabStop="False"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <StackPanel
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="2">
        <Button
            AutomationProperties.Name="{x:Bind ViewModel.BackToolTip, Mode=OneWay}"
            Click="{x:Bind ViewModel.GoBack}"
            Content="&#xE72B;"
            FontFamily="Segoe Fluent Icons"
            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.BackToolTip, Mode=OneWay}">
            <Button.Style>
                <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </Button.Style>
        </Button>
        <Button
            AutomationProperties.Name="{x:Bind ViewModel.ForwardToolTip, Mode=OneWay}"
            Click="{x:Bind ViewModel.GoForward}"
            Content="&#xE72A;"
            FontFamily="Segoe Fluent Icons"
            IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.ForwardToolTip, Mode=OneWay}">
            <Button.Style>
                <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </Button.Style>
        </Button>
        <Button
            x:Uid="DesktopHistoryMenuButton"
            Content="&#xE81C;"
            FontFamily="Segoe Fluent Icons"
            IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}">
            <Button.Style>
                <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </Button.Style>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <Grid Width="360" MaxHeight="440">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="DesktopHistoryBackHeader"
                            Margin="8,4,8,6"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView
                            Grid.Row="1"
                            MaxHeight="150"
                            IsItemClickEnabled="False"
                            IsTabStop="False"
                            ItemsSource="{x:Bind ViewModel.BackEntries, Mode=OneWay}"
                            SelectionMode="None"
                            Visibility="{x:Bind ToEntriesVisibility(ViewModel.BackEntries.Count), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="Shell:DesktopHistoryItemViewModel">
                                    <Button
                                        Padding="8,6"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="{x:Bind Navigate}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="16"
                                                Glyph="{x:Bind Glyph}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    MaxLines="1"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind PageLabel}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind VisitedLabel}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Uid="DesktopHistoryEmptyBack"
                            Grid.Row="1"
                            Margin="8,6,8,12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ToEmptyVisibility(ViewModel.BackEntries.Count), Mode=OneWay}" />
                        <TextBlock
                            x:Uid="DesktopHistoryForwardHeader"
                            Grid.Row="2"
                            Margin="8,12,8,6"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView
                            Grid.Row="3"
                            MaxHeight="150"
                            IsItemClickEnabled="False"
                            IsTabStop="False"
                            ItemsSource="{x:Bind ViewModel.ForwardEntries, Mode=OneWay}"
                            SelectionMode="None"
                            Visibility="{x:Bind ToEntriesVisibility(ViewModel.ForwardEntries.Count), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="Shell:DesktopHistoryItemViewModel">
                                    <Button
                                        Padding="8,6"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="{x:Bind Navigate}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="16"
                                                Glyph="{x:Bind Glyph}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    MaxLines="1"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind PageLabel}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind VisitedLabel}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Uid="DesktopHistoryEmptyForward"
                            Grid.Row="3"
                            Margin="8,6,8,12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ToEmptyVisibility(ViewModel.ForwardEntries.Count), Mode=OneWay}" />
                        <Rectangle
                            Grid.Row="4"
                            Height="1"
                            Margin="0,8"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            x:Uid="DesktopHistoryClearButton"
                            Grid.Row="5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="{x:Bind ViewModel.Clear}"
                            IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
