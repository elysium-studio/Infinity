<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Infinity.Shell.WinUI.OverviewBackdropView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="{x:Bind ViewModel.Activate}"
    Unloaded="{x:Bind ViewModel.Deactivate}">
    <CommunityToolkit:SettingsCard x:Uid="OverviewBackdropCard">
        <ComboBox MinWidth="132" SelectedIndex="{x:Bind ViewModel.Value, Mode=TwoWay}">
            <ComboBoxItem x:Uid="OverviewBackdropWallpaperOption" />
            <ComboBoxItem x:Uid="OverviewBackdropDarkOption" />
            <ComboBoxItem x:Uid="OverviewBackdropLightOption" />
        </ComboBox>
    </CommunityToolkit:SettingsCard>
</UserControl>
