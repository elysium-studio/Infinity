<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Infinity.Shell.WinUI.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">
    <StackPanel
        Width="360"
        HorizontalAlignment="Center"
        Spacing="4">
        <Image
            Width="112"
            Height="112"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            Source="ms-appx:///Assets/Infinity.png" />
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="24"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.Title}" />
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Version}" />
        <TextBlock
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Copyright}" />
        <HyperlinkButton
            HorizontalAlignment="Center"
            Padding="4,0"
            Content="elysiumstud.io"
            NavigateUri="{x:Bind ViewModel.WebsiteUri}" />
    </StackPanel>
</ContentDialog>
